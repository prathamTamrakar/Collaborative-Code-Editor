# ==============================================================
# CLIENT ENVIRONMENT CONFIGURATION (Vite)
# NOTE: All client-side env variables MUST start with VITE_
# ==============================================================

# Backend WebSocket / Server URL
# Local Development: http://localhost:5000
# Production: https://your-server-domain.com
# If omitted or empty, client will auto-detect localhost (port 5000) or current host origin
VITE_SOCKET_URL=http://localhost:5000
