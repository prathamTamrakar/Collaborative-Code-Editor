# ==============================================================
# SERVER ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust values for your environment.
# ==============================================================

# Port the Express & Socket.io server listens on
PORT=5000

# Environment mode: 'development' | 'production'
NODE_ENV=development

# Allowed Client Origin(s) for CORS.
# For local dev: http://localhost:5173
# For production: https://your-frontend-domain.com
# Multiple origins can be comma-separated: https://site.com,https://preview.site.com
# Use '*' to allow all origins (not recommended for strict production)
CLIENT_URL=http://localhost:5173
